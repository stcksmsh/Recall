{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "aiw hook session-start",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "aiw hook stop --strict",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "aiw hook session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
